0  => x"000012b7",   -- lui  x5, 0x1      : x5 = 0x1000 (dirección LEDs)
    1  => x"00f00313",   -- addi x6, x0, 15   : x6 = 0xF (patrón encendido)
    2  => x"00000413",   -- addi x8, x0, 0    : x8 = 0 (patrón apagado)
    -- loop:
    3  => x"0062a023",   -- sw   x6, 0(x5)    : LEDs = 0xF (encender)
    4  => x"001003b7",   -- lui  x7, 0x100    : x7 = ~1M (delay)
    5  => x"fff38393",   -- addi x7, x7, -1   : x7--
    6  => x"fe039ee3",   -- bne  x7, x0, -4   : repite delay (addr 5)
    7  => x"0082a023",   -- sw   x8, 0(x5)    : LEDs = 0 (apagar)
    8  => x"001003b7",   -- lui  x7, 0x100    : x7 = ~1M (delay otra vez)
    9  => x"fff38393",   -- addi x7, x7, -1
    10 => x"fe039ee3",   -- bne  x7, x0, -4   : repite delay (addr 9)
    11 => x"fe1ff06f",   -- jal  x0, -32      : vuelve a addr 3
    others => x"00000013"
